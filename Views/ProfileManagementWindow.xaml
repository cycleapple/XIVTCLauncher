<Window x:Class="FFXIVSimpleLauncher.Views.ProfileManagementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Dalamud 插件設定檔"
        Height="560"
        Width="760"
        MinHeight="500"
        MinWidth="700"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        FontFamily="{materialDesign:MaterialDesignFont}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Dalamud 插件設定檔"
                           FontSize="22"
                           FontWeight="SemiBold"/>
                <TextBlock Text="為不同帳號保存獨立的插件與 Dalamud 設定；共用設定永遠保留。"
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </StackPanel>
            <Button x:Name="StartCreateButton"
                    Grid.Column="1"
                    Content="+ 新增設定檔"
                    Click="StartCreateButton_Click"
                    Style="{StaticResource AppPrimaryButton}"
                    VerticalAlignment="Center"/>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{DynamicResource AppSurfaceBrush}"
                    BorderBrush="{DynamicResource AppDividerBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top"
                               Text="已建立的設定檔"
                               FontWeight="SemiBold"
                               Margin="6,4,6,10"/>
                    <ListBox x:Name="ProfilesList"
                             SelectionChanged="ProfilesList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="5,6">
                                    <TextBlock Text="{Binding Name}"
                                               FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Description}"
                                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                                               FontSize="11"
                                               Margin="0,2,0,0"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- Existing-profile view/edit state -->
            <ScrollViewer x:Name="ExistingProfilePanel"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="設定檔詳細資料"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Margin="0,0,0,16"/>

                    <TextBlock Text="名稱"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBox x:Name="NameTextBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,5,0,12"
                             MaxLength="60"/>

                    <TextBlock Text="說明"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBox x:Name="DescriptionTextBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,5,0,12"
                             Height="72"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>

                    <TextBlock x:Name="BindingInfoText"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,2,0,16"/>

                    <WrapPanel Margin="0,0,0,14">
                        <Button Content="儲存變更"
                                Click="SaveButton_Click"
                                Style="{StaticResource AppPrimaryButton}"
                                Margin="0,0,8,8"/>
                        <Button Content="開啟資料夾"
                                Click="OpenFolderButton_Click"
                                Style="{StaticResource AppSecondaryButton}"
                                Margin="0,0,8,8"/>
                    </WrapPanel>

                    <Separator Margin="0,0,0,14"/>

                    <Button Content="刪除此設定檔"
                            Click="DeleteButton_Click"
                            Style="{StaticResource AppDangerButton}"
                            HorizontalAlignment="Left"/>
                </StackPanel>
            </ScrollViewer>

            <!-- New-profile state; only shown after the user explicitly starts creation. -->
            <ScrollViewer x:Name="CreateProfilePanel"
                          Grid.Column="2"
                          VerticalScrollBarVisibility="Auto"
                          Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="建立新的插件設定檔"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="可從空白開始，或複製現有設定檔的插件與設定。"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"
                               Margin="0,4,0,16"/>

                    <TextBlock Text="名稱"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBox x:Name="CreateNameTextBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,5,0,12"
                             MaxLength="60"/>

                    <TextBlock Text="說明（選填）"
                               Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBox x:Name="CreateDescriptionTextBox"
                             Style="{StaticResource MaterialDesignOutlinedTextBox}"
                             Margin="0,5,0,14"
                             Height="72"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"/>

                    <CheckBox x:Name="CopyExistingCheckBox"
                              Content="複製現有設定檔的插件與設定"
                              IsChecked="False"
                              Margin="0,0,0,8"
                              Checked="CopyExistingCheckBox_Changed"
                              Unchecked="CopyExistingCheckBox_Changed"/>

                    <ComboBox x:Name="CopySourceComboBox"
                              DisplayMemberPath="Name"
                              SelectedValuePath="Id"
                              IsEnabled="False"
                              Style="{StaticResource MaterialDesignOutlinedComboBox}"
                              materialDesign:HintAssist.Hint="來源設定檔"
                              Margin="24,0,0,18"/>

                    <StackPanel Orientation="Horizontal">
                        <Button Content="建立設定檔"
                                Click="CreateButton_Click"
                                Style="{StaticResource AppPrimaryButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="取消"
                                Click="CancelCreateButton_Click"
                                Style="{StaticResource AppSecondaryButton}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Empty state shown when no independent profile exists. -->
            <StackPanel x:Name="EmptyStatePanel"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Visibility="Collapsed">
                <materialDesign:PackIcon Kind="PuzzleOutline"
                                         Width="48"
                                         Height="48"
                                         Foreground="{DynamicResource AppTextDisabledBrush}"
                                         HorizontalAlignment="Center"/>
                <TextBlock Text="尚未建立獨立的插件設定檔"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Margin="0,12,0,4"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="按右上角「新增設定檔」開始建立。"
                           Foreground="{DynamicResource AppTextSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <Button Grid.Row="2"
                Content="完成"
                Click="CloseButton_Click"
                Style="{StaticResource AppSecondaryButton}"
                HorizontalAlignment="Right"
                Width="100"
                Margin="0,18,0,0"/>
    </Grid>
</Window>
