<Window x:Class="FFXIVSimpleLauncher.Views.ConnectionDiagnosticsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="連線診斷" Width="760" Height="700" MinWidth="520" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}" FontSize="14">
    <DockPanel Margin="24" Background="{DynamicResource MaterialDesignPaper}">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="連線診斷" FontSize="22" Margin="0,0,0,12"/>
            <TextBlock Text="從這台電腦檢查各項服務。無法連線不代表全體伺服器當機；可連線也不保證能登入各個遊戲世界。耗時是單次連線／HTTP 回應時間，不是遊戲延遲。"
                       TextWrapping="Wrap"/>
            <WrapPanel Margin="0,16,0,12">
                <Button x:Name="RunButton" Content="開始檢測" Click="Run_Click" Style="{StaticResource AppPrimaryButton}" Margin="0,0,8,8"/>
                <Button x:Name="CancelButton" Content="取消" Click="Cancel_Click" IsEnabled="False" Style="{StaticResource AppSecondaryButton}" Margin="0,0,8,8"/>
                <Button x:Name="CopyButton" Content="複製報告" Click="Copy_Click" IsEnabled="False" Style="{StaticResource AppSecondaryButton}" Margin="0,0,0,8"/>
            </WrapPanel>
            <ProgressBar x:Name="BusyBar" Height="6" Visibility="Collapsed" Margin="0,0,0,12"/>
            <TextBlock x:Name="StatusText" Text="按「開始檢測」執行，每項最多等待 8 秒，可隨時取消。" TextWrapping="Wrap" Margin="0,0,0,12"/>
        </StackPanel>
        <TextBox x:Name="ReportText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 Background="Transparent" BorderThickness="0" Padding="8"/>
    </DockPanel>
</Window>
